          "name": "Upload an image",
          "request": {
            "name": "Upload an image",
            "description": {
              "content": "Uploads an image to Medium for use in posts. The image must be sent as multipart form data with the field name \"image\". Supported formats are JPEG, PNG, GIF, and TIFF. Only one image can be uploaded per request. Medium also automatically side-loads images referenced in img src attributes within post content.",
              "type": "text/plain"
            },
