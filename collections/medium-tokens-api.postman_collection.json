          "name": "Refresh an access token",
          "request": {
            "name": "Refresh an access token",
            "description": {
              "content": "Exchanges a refresh token for a new access token. This endpoint is used when the current access token has expired. The new access token is valid for another 60 days. A new refresh token may also be returned.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v1",
                "tokens",
                "refresh"
